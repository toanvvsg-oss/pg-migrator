{
  "uid": "pg-migration-overview",
  "title": "PG Zero-Downtime Migration Overview",
  "tags": ["postgresql", "migration", "cloudpay", "victoriametrics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "CloudPay Demo App & Database Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "stat",
      "title": "CloudPay Active DB",
      "id": 2,
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "cloudpay_active_db{db=\"targetdb\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "sourcedb (PG 15)", "color": "blue" }, "1": { "text": "targetdb (PG 16)", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "stat",
      "title": "CloudPay Live TPS",
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "cloudpay_workload_actual_tps", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 1 } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Failed Requests",
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "cloudpay_transactions_total{op=\"error\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "stat",
      "title": "Max Latency Spike",
      "id": 5,
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "cloudpay_query_latency_ms_max", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 3000 }] }
        }
      },
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "stat",
      "title": "Source PG (15)",
      "id": 6,
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "pg_up{role=\"source\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "stat",
      "title": "Target PG (16)",
      "id": 7,
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [{ "expr": "pg_up{role=\"target\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "timeseries",
      "title": "CloudPay Operations / sec (by op)",
      "id": 8,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "rate(cloudpay_transactions_total[30s])", "legendFormat": "{{op}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "CloudPay Query Latency (ms)",
      "id": 9,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "cloudpay_query_latency_ms_avg", "legendFormat": "avg latency", "refId": "A" },
        { "expr": "cloudpay_query_latency_ms_max", "legendFormat": "max spike", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "row",
      "title": "PostgreSQL Source vs Target — Activity & Replication",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Transactions / sec (Source vs Target)",
      "id": 11,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=~\"sourcedb|targetdb\"}[30s])", "legendFormat": "{{role}} ({{datname}}) commits", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname=~\"sourcedb|targetdb\"}[30s])", "legendFormat": "{{role}} ({{datname}}) rollbacks", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Tuple Writes / sec (Source vs Target)",
      "id": 12,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_inserted{datname=~\"sourcedb|targetdb\"}[30s])", "legendFormat": "{{role}} inserts/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_tup_updated{datname=~\"sourcedb|targetdb\"}[30s])", "legendFormat": "{{role}} updates/s", "refId": "B" },
        { "expr": "rate(pg_stat_database_tup_deleted{datname=~\"sourcedb|targetdb\"}[30s])", "legendFormat": "{{role}} deletes/s", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Active Connections (Source vs Target)",
      "id": 13,
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "pg_stat_database_numbackends{datname=~\"sourcedb|targetdb\"}", "legendFormat": "{{role}} ({{datname}})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "type": "timeseries",
      "title": "Database Size (Source vs Target)",
      "id": 14,
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "pg_database_size_bytes{datname=~\"sourcedb|targetdb\"}", "legendFormat": "{{role}} ({{datname}})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "Buffer Cache Hit Ratio (%)",
      "id": 15,
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "expr": "100 * rate(pg_stat_database_blks_hit{datname=~\"sourcedb|targetdb\"}[1m]) / clamp_min(rate(pg_stat_database_blks_hit{datname=~\"sourcedb|targetdb\"}[1m]) + rate(pg_stat_database_blks_read{datname=~\"sourcedb|targetdb\"}[1m]), 1)",
          "legendFormat": "{{role}} ({{datname}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Logical Replication WAL Retained / Lag (Source)",
      "id": 16,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "pg_replication_slots_pg_wal_lsn_diff{role=\"source\"}", "legendFormat": "slot {{slot_name}} WAL retained", "refId": "A" },
        { "expr": "pg_stat_replication_pg_wal_lsn_diff{role=\"source\"}", "legendFormat": "replica {{application_name}} lag", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "Logical Replication Slot Active (Source)",
      "id": 17,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "pg_replication_slots_active{role=\"source\"}", "legendFormat": "slot {{slot_name}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "decimals": 0 } }
    }
  ]
}
