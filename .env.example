# Copy to .env or run `make init-env` to auto-generate strong random secrets
WEB_PORT=8080
DEMO_APP_PORT=8081
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN

# Encryption key (min 32 chars) for AES-256-GCM credential encryption in pg-meta
APP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_MAKE_INIT_ENV

# Optional API authentication token for /api/* (leave empty to disable)
# API_AUTH_TOKEN=

# PostgreSQL Metadata Store (pg-meta)
META_DB_PASSWORD=CHANGE_ME_META_PASSWORD

# Docker Lab Source (Cloud A - PG 15) & Target (Cloud B - PG 16)
SOURCE_ADMIN_PASSWORD=CHANGE_ME_SRC_ADMIN
TARGET_ADMIN_PASSWORD=CHANGE_ME_TGT_ADMIN
SOURCE_MIGRATOR_PASSWORD=CHANGE_ME_SRC_MIGRATOR
TARGET_MIGRATOR_PASSWORD=CHANGE_ME_TGT_MIGRATOR
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
PGBOUNCER_ADMIN_PASSWORD=CHANGE_ME_PGBOUNCER_ADMIN

# TPC-H Seeder: 10 = ~10-14 GiB in Postgres, 1 = ~1.3 GiB for quick test
TPCH_SCALE_FACTOR=10
WORKLOAD_TPS=15
